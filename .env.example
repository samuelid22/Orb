# ORB server-side environment template.
# Copy to .env for local use. Never commit a populated .env file.

# Optional. Enables real Gemini analysis from the server only.
# Without it, the inherited analysis engine runs in mock mode.
GEMINI_API_KEY=

# Optional local storage overrides. Defaults are shown.
# PROMETHEUS_API_OUTPUT_DIR=orb_output
# PROMETHEUS_API_UPLOAD_DIR=orb_uploads

# IMPORTANT: The inherited Nimiq payment code is DISABLED in Orb by default.
# Do not set ORB_ENABLE_NIMIQ_PAYMENTS. Orb will use its own Arbitrum Sepolia
# payment and entitlement system in a later stage.
# ORB_ENABLE_NIMIQ_PAYMENTS=
