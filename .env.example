# ORB server-side environment template.
# Copy to .env for local use. Never commit a populated .env file.

# Required for explicit local AI testing. Keep the API key on the server only.
ORB_ENV=local
ORB_AI_LOCAL_TESTING=1
ORB_AI_PROVIDER=gemini
# ORB_AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Or choose ORB_AI_PROVIDER=openai and set OPENAI_API_KEY instead.

# Optional Orb-only local storage overrides. Defaults are shown.
# ORB_OUTPUT_DIR=api_output
# ORB_UPLOAD_DIR=uploads

# Stage 4 Arbitrum Sepolia TESTNET credits. Leave disabled until every setting
# below is configured. Use a dedicated receiving EOA, never a private key.
# Set ORB_AI_LOCAL_TESTING=0 to exercise paid gating on local loopback.
ORB_CREDITS_ENABLED=0
ORB_PUBLIC_ORIGIN=http://127.0.0.1:5174
ORB_ARBITRUM_RPC_URL=
ORB_CREDIT_RECEIVER=
ORB_CREDIT_PRICE_WEI=1000000000000
ORB_PAYMENT_CONFIRMATIONS=3
ORB_CREDIT_DB=api_output/orb_credits.sqlite3

# Public Render deployment uses dashboard environment variables, not this
# local .env file. Attach a persistent disk at /var/data on one paid service.
# Required production storage values:
# ORB_ENV=production
# ORB_AI_LOCAL_TESTING=0
# ORB_CREDITS_ENABLED=1
# ORB_PUBLIC_ORIGIN=https://<orb-vercel-domain>
# ORB_DATA_DIR=/var/data
# ORB_OUTPUT_DIR=/var/data/results
# ORB_CREDIT_DB=/var/data/ledger/credits.sqlite3
# ORB_UPLOAD_DIR=/tmp/orb_uploads
# ORB_ARBITRUM_RPC_URL=https://<trusted-arbitrum-sepolia-rpc>
# ORB_CREDIT_RECEIVER=0x<dedicated-orb-testnet-wallet>

# IMPORTANT: The inherited Nimiq payment code is DISABLED in Orb by default.
# Do not set ORB_ENABLE_NIMIQ_PAYMENTS. Orb will use its own Arbitrum Sepolia
# payment and entitlement system separately.
# ORB_ENABLE_NIMIQ_PAYMENTS=
